---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FocusCard from '../../components/FocusCard.astro';
import FormFactorCard from '../../components/FormFactorCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import DemoRequestForm from '../../components/DemoRequestForm.astro';
import { getContent } from '../../i18n/content';

const t = getContent('en');
---

<BaseLayout locale="en" title={t.meta.title} description={t.meta.description} nav={t.nav} footerTagline={t.footer.tagline}>
  <Hero hero={t.hero} />

  <section class="problem">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">{t.problem.eyebrow}</span>
        <h2>{t.problem.headline}</h2>
        <p>{t.problem.body}</p>
      </div>
      <div class="chart-card reveal">
        <svg viewBox="0 0 380 200" width="100%" height="auto">
          <line x1="30" y1="20" x2="30" y2="160" stroke="var(--paper-line)" stroke-width="1"></line>
          <line x1="30" y1="160" x2="360" y2="160" stroke="var(--paper-line)" stroke-width="1"></line>
          <text x="18" y="24" font-family="JetBrains Mono" font-size="9.5" fill="var(--fog-dark)">{t.problem.chart.axis_high}</text>
          <text x="10" y="164" font-family="JetBrains Mono" font-size="9.5" fill="var(--fog-dark)">{t.problem.chart.axis_low}</text>
          <line x1="210" y1="20" x2="210" y2="160" stroke="#8890A0" stroke-width="1" stroke-dasharray="3 4"></line>
          <text x="185" y="176" font-family="JetBrains Mono" font-size="9.5" fill="var(--fog-dark)">{t.problem.chart.axis_door}</text>
          <text x="30" y="176" font-family="JetBrains Mono" font-size="9.5" fill="var(--fog-dark)">{t.problem.chart.axis_outdoor}</text>
          <text x="300" y="176" font-family="JetBrains Mono" font-size="9.5" fill="var(--fog-dark)">{t.problem.chart.axis_indoor}</text>
          <path d="M30,50 C110,45 170,50 210,55 C250,110 300,150 360,152" fill="none" stroke="#C7BFA6" stroke-width="2.5"></path>
          <path d="M30,45 C110,42 170,46 210,48 C250,52 300,50 360,54" fill="none" stroke="var(--amber)" stroke-width="2.5"></path>
        </svg>
        <div class="chart-legend">
          <span class="legend-item"><span class="swatch" style="background:#C7BFA6"></span>{t.problem.chart.legend_typical}</span>
          <span class="legend-item"><span class="swatch" style="background:var(--amber)"></span>{t.problem.chart.legend_continuous}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="product" id="product">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">{t.product.eyebrow}</span>
        <h2>{t.product.headline}</h2>
        <p class="lead">{t.product.lead}</p>
      </div>
      <div class="form-grid">
        {t.product.forms.map((f) => <FormFactorCard index={f.index} title={f.title} body={f.body} />)}
      </div>
      <div class="spec-strip">
        {t.product.specs.map((spec) => <span>{spec}</span>)}
      </div>
      <p class="note">{t.product.note}</p>
      <a href="#demo" class="btn btn-primary product-demo-cta">{t.product.demo_cta}</a>
    </div>
  </section>

  <section class="focus" id="focus">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">{t.focus.eyebrow}</span>
        <h2>{t.focus.headline}</h2>
        <p class="lead">{t.focus.lead}</p>
      </div>
      <div class="focus-grid">
        {t.focus.cards.map((c) => <FocusCard tag={c.tag} title={c.title} body={c.body} />)}
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">{t.about.eyebrow}</span>
        <h2>{t.about.headline}</h2>
      </div>
      <div class="about-grid">
        {t.about.cards.map((c) => (
          <div class="about-card reveal">
            <span class="role">{c.role}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <div class="contact-intro reveal">
        <span class="eyebrow">{t.contact.eyebrow}</span>
        <h2>{t.contact.headline}</h2>
        <p>{t.contact.body}</p>
        <a class="contact-email" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
      </div>
      <div class="contact-panels">
        <div class="panel panel-demo reveal" id="demo">
          <h3>{t.contact.demo.title}</h3>
          <p class="panel-subtitle">{t.contact.demo.subtitle}</p>
          <DemoRequestForm form={t.contact.demo.form} />
        </div>
        <div class="panel panel-general reveal">
          <h3>{t.contact.general.title}</h3>
          <ContactForm form={t.contact.general.form} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .problem .wrap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .problem .wrap {
      grid-template-columns: 1fr;
    }
  }

  .problem .eyebrow {
    color: var(--fog-dark);
  }

  .problem h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    margin: 16px 0 18px;
    line-height: 1.2;
  }

  .problem p {
    color: var(--fog-dark);
    font-size: 16px;
    max-width: 480px;
  }

  .chart-card {
    background: #fff;
    border: 1px solid var(--paper-line);
    border-radius: 6px;
    padding: 28px 26px 20px;
  }

  .chart-legend {
    display: flex;
    gap: 22px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--fog-dark);
  }

  .swatch {
    width: 16px;
    height: 2px;
  }

  .product {
    background: var(--ink);
    color: var(--paper);
  }

  .product .eyebrow {
    color: var(--amber-bright);
  }

  .product h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    color: #fff;
    margin: 16px 0 16px;
    max-width: 640px;
  }

  .product p.lead {
    color: rgba(236, 231, 216, 0.68);
    max-width: 640px;
    font-size: 16px;
    margin-bottom: 48px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(236, 231, 216, 0.12);
    border-radius: 8px;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .form-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .spec-strip {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid rgba(236, 231, 216, 0.14);
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: rgba(236, 231, 216, 0.5);
  }

  .note {
    margin-top: 28px;
    font-size: 13px;
    color: rgba(236, 231, 216, 0.42);
    max-width: 640px;
  }

  .product-demo-cta {
    margin-top: 32px;
  }

  .focus .eyebrow {
    color: var(--fog-dark);
  }

  .focus h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    margin: 16px 0 16px;
    max-width: 600px;
  }

  .focus p.lead {
    color: var(--fog-dark);
    max-width: 600px;
    font-size: 16px;
    margin-bottom: 48px;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  @media (max-width: 900px) {
    .focus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }

  .about {
    background: var(--navy);
    color: var(--paper);
  }

  .about .eyebrow {
    color: var(--amber-bright);
  }

  .about h2 {
    color: #fff;
    font-size: clamp(26px, 3.4vw, 36px);
    margin: 16px 0 44px;
    max-width: 620px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-card {
    border: 1px solid rgba(236, 231, 216, 0.14);
    border-radius: 6px;
    padding: 30px 28px;
  }

  .about-card .role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
  }

  .about-card h3 {
    font-size: 19px;
    color: #fff;
    margin-bottom: 12px;
  }

  .about-card p {
    font-size: 14.5px;
    color: rgba(236, 231, 216, 0.66);
  }

  .contact .eyebrow {
    color: var(--fog-dark);
  }

  .contact h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    margin: 16px 0 18px;
  }

  .contact p {
    color: var(--fog-dark);
    font-size: 16px;
    max-width: 480px;
  }

  .contact-email {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--navy);
    border-bottom: 1.5px solid var(--amber);
    padding-bottom: 4px;
  }

  .contact-panels {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .contact-panels {
      grid-template-columns: 1fr;
    }
  }

  .panel-demo {
    background: #fff;
    border: 1px solid var(--paper-line);
    border-top: 3px solid var(--amber);
    border-radius: 6px;
    padding: 32px 28px;
    scroll-margin-top: 88px;
  }

  .panel-demo h3 {
    font-size: 20px;
    margin-bottom: 6px;
  }

  .panel-subtitle {
    color: var(--fog-dark);
    font-size: 14.5px;
    margin-bottom: 20px;
  }

  .panel-general {
    padding: 10px 4px;
  }

  .panel-general h3 {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--fog-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 18px;
  }
</style>

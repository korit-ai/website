---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent } from '../../i18n/content';

const t = getContent('tr');
---

<BaseLayout
  locale="tr"
  title={`${t.portal.eyebrow} · korit.ai`}
  description={t.portal.body}
  nav={t.nav}
  footerTagline={t.footer.tagline}
>
  <section class="portal">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">{t.portal.eyebrow}</span>
        <h1>{t.portal.headline}</h1>
        <p>{t.portal.body}</p>

        <form class="notify-form reveal" data-success={t.portal.form.success} data-error={t.portal.form.error}>
          <div class="field">
            <label for="pemail">{t.portal.form.email_label}</label>
            <input id="pemail" name="email" type="email" required />
          </div>
          <button type="submit" class="btn btn-primary">{t.portal.form.submit}</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>

        <a class="back-link" href="/tr/">{t.portal.back_link}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .portal {
    min-height: calc(100vh - 72px - 121px);
    display: flex;
    align-items: center;
  }

  .portal .eyebrow {
    color: var(--fog-dark);
  }

  .portal h1 {
    font-size: clamp(28px, 4vw, 42px);
    margin: 16px 0 18px;
  }

  .portal p {
    color: var(--fog-dark);
    font-size: 16px;
    max-width: 480px;
    margin-bottom: 30px;
  }

  .notify-form {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
    max-width: 480px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 220px;
  }

  label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fog-dark);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  input {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--paper-line);
    border-radius: 4px;
    padding: 12px 14px;
  }

  .notify-form .btn {
    border: none;
  }

  .form-status {
    width: 100%;
    font-size: 13.5px;
    color: var(--navy);
  }

  .form-status[data-state='err'] {
    color: #b0432c;
  }

  .back-link {
    display: inline-block;
    margin-top: 34px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fog-dark);
    border-bottom: 1px solid var(--paper-line);
    padding-bottom: 2px;
  }

  .back-link:hover {
    color: var(--ink);
  }
</style>

<script>
  import { submitLead } from '../../lib/leadForm';
  import { trackEvent } from '../../lib/analytics';

  const formEl = document.querySelector<HTMLFormElement>('.notify-form');

  formEl?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    submitButton?.setAttribute('disabled', 'true');

    const email = form.querySelector<HTMLInputElement>('#pemail')?.value ?? '';

    try {
      await submitLead({ email }, 'Portal Interest');
      trackEvent('portal_interest_submitted');
      if (status) {
        status.textContent = form.dataset.success ?? '';
        status.dataset.state = 'ok';
      }
      form.reset();
    } catch {
      if (status) {
        status.textContent = form.dataset.error ?? '';
        status.dataset.state = 'err';
      }
    } finally {
      submitButton?.removeAttribute('disabled');
    }
  });
</script>

---
// Standalone demo-request landing page — the destination URL for paid
// campaign traffic (M3 milestone), kept separate from the anchor-scroll
// `#demo` CTA on the main page. See kb/project/content-inventory.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoRequestForm from '../../components/DemoRequestForm.astro';
import { getContent } from '../../i18n/content';

const t = getContent('tr');
---

<BaseLayout
  locale="tr"
  title={t.demoPage.meta.title}
  description={t.demoPage.meta.description}
  nav={t.nav}
  footerTagline={t.footer.tagline}
  noindex={true}
>
  <section class="demo-intro">
    <div class="wrap">
      <span class="eyebrow">{t.demoPage.eyebrow}</span>
      <h1>{t.demoPage.headline}</h1>
      <p class="lead">{t.demoPage.subhead}</p>
      <div class="trust-strip">
        <span><b>{t.hero.baseline.founder.label}</b> — {t.hero.baseline.founder.value}</span>
        <span><b>{t.hero.baseline.partner.label}</b> — {t.hero.baseline.partner.value}</span>
        <span><b>{t.hero.baseline.status.label}</b> — {t.hero.baseline.status.value}</span>
      </div>
      <div class="spec-strip">
        {t.product.specs.map((spec) => <span>{spec}</span>)}
      </div>
    </div>
  </section>

  <section class="demo-form-section">
    <div class="wrap">
      <div class="panel-demo reveal">
        <h2>{t.contact.demo.title}</h2>
        <p class="panel-subtitle">{t.contact.demo.subtitle}</p>
        <DemoRequestForm form={t.contact.demo.form} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .demo-intro {
    background: var(--navy);
    color: var(--paper);
    padding: 88px 0 56px;
  }

  .demo-intro h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    line-height: 1.12;
    color: #fff;
    margin: 20px 0 16px;
    max-width: 640px;
  }

  .demo-intro .eyebrow {
    color: var(--amber-bright);
  }

  .demo-intro .lead {
    font-size: 17px;
    color: rgba(236, 231, 216, 0.72);
    max-width: 520px;
    margin-bottom: 32px;
  }

  .trust-strip {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: rgba(236, 231, 216, 0.55);
    padding-top: 22px;
    border-top: 1px solid rgba(236, 231, 216, 0.14);
  }

  .trust-strip b {
    color: var(--paper);
    font-weight: 500;
  }

  .spec-strip {
    margin-top: 22px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(236, 231, 216, 0.42);
  }

  .demo-form-section {
    padding: 64px 0 110px;
  }

  .demo-form-section .wrap {
    max-width: 640px;
  }

  .panel-demo {
    background: #fff;
    border: 1px solid var(--paper-line);
    border-top: 3px solid var(--amber);
    border-radius: 6px;
    padding: 36px 32px;
  }

  .panel-demo h2 {
    font-size: 22px;
    margin-bottom: 6px;
  }

  .panel-subtitle {
    color: var(--fog-dark);
    font-size: 14.5px;
    margin-bottom: 22px;
  }
</style>

---
// Animated "point-cloud resolves into a building" signature graphic.
// Respects prefers-reduced-motion — see the media query below.
---

<svg viewBox="0 0 460 380" width="100%" height="100%" aria-hidden="true">
  <g class="building-dots">
    <circle cx="90" cy="300" r="2.5" style="animation-delay:.1s"></circle>
    <circle cx="120" cy="300" r="2.5" style="animation-delay:.3s"></circle>
    <circle cx="150" cy="300" r="2.5" style="animation-delay:.5s"></circle>
    <circle cx="330" cy="300" r="2.5" style="animation-delay:.6s"></circle>
    <circle cx="360" cy="300" r="2.5" style="animation-delay:.8s"></circle>
    <circle cx="90" cy="180" r="2.5" style="animation-delay:.9s"></circle>
    <circle cx="360" cy="180" r="2.5" style="animation-delay:1.1s"></circle>
    <circle cx="90" cy="120" r="2.5" style="animation-delay:1.2s"></circle>
    <circle cx="360" cy="120" r="2.5" style="animation-delay:1.35s"></circle>
    <circle cx="225" cy="60" r="2.5" style="animation-delay:1.5s"></circle>
    <circle cx="160" cy="220" r="2" style="animation-delay:.7s"></circle>
    <circle cx="290" cy="220" r="2" style="animation-delay:.95s"></circle>
    <circle cx="225" cy="140" r="2" style="animation-delay:1.05s"></circle>
    <circle cx="180" cy="300" r="2" style="animation-delay:.4s"></circle>
    <circle cx="270" cy="300" r="2" style="animation-delay:.55s"></circle>
  </g>
  <path
    class="building-solid"
    d="M90,300 L90,120 L225,60 L360,120 L360,300 L90,300 M90,180 L360,180 M160,300 L160,220 L200,220 L200,300 M260,300 L260,240 L300,240 L300,300"
  ></path>
  <rect class="sweep" x="0" y="40" width="14" height="280" fill="url(#sweepgrad)"></rect>
  <defs>
    <linearGradient id="sweepgrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#6FCFC0" stop-opacity="0"></stop>
      <stop offset="50%" stop-color="#6FCFC0" stop-opacity="0.9"></stop>
      <stop offset="100%" stop-color="#6FCFC0" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
</svg>

<style>
  .building-dots circle {
    fill: var(--cyan);
    opacity: 0;
    animation: dotpop 4.2s ease-in-out infinite;
  }

  .building-solid {
    fill: none;
    stroke: var(--amber-bright);
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1400;
    animation: draw 4.2s ease-in-out infinite;
  }

  .sweep {
    animation: sweepmove 4.2s linear infinite;
  }

  @keyframes draw {
    0% {
      stroke-dashoffset: 1400;
      opacity: 0.25;
    }
    45% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    75% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 1400;
      opacity: 0.25;
    }
  }

  @keyframes dotpop {
    0%,
    100% {
      opacity: 0;
    }
    20% {
      opacity: 0;
    }
    35% {
      opacity: 0.9;
    }
    75% {
      opacity: 0.9;
    }
    92% {
      opacity: 0;
    }
  }

  @keyframes sweepmove {
    0% {
      transform: translateX(-40px);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    50% {
      transform: translateX(420px);
      opacity: 0.9;
    }
    60% {
      opacity: 0;
    }
    100% {
      transform: translateX(420px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .building-dots circle,
    .building-solid,
    .sweep {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>

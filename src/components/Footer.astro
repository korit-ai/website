---
interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <img src="/logo/korit-wordmark-on-dark.svg" alt="korit.ai" class="flogo" />
    <span class="fmeta">© {year} korit.ai · {tagline}</span>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: rgba(236, 231, 216, 0.55);
    padding: 40px 0;
  }

  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .flogo {
    height: 17px;
    width: auto;
    display: block;
  }

  .fmeta {
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>

---
// Google Form-backed general-inquiry form. See src/lib/leadForm.ts and
// kb/project/specs/lead-capture-demo-analytics.md for the backend/analytics wiring.
interface Props {
  form: {
    name_label: string;
    email_label: string;
    message_label: string;
    message_placeholder: string;
    submit: string;
    success: string;
    error: string;
  };
}

const { form } = Astro.props;
---

<form class="reveal contact-form" data-success={form.success} data-error={form.error}>
  <div class="field">
    <label for="cname">{form.name_label}</label>
    <input id="cname" name="name" type="text" required />
  </div>
  <div class="field">
    <label for="cemail">{form.email_label}</label>
    <input id="cemail" name="email" type="email" required />
  </div>
  <div class="field">
    <label for="cmsg">{form.message_label}</label>
    <textarea id="cmsg" name="message" required placeholder={form.message_placeholder}></textarea>
  </div>
  <div class="submit-row">
    <button type="submit" class="btn btn-primary">{form.submit}</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fog-dark);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--paper-line);
    border-radius: 4px;
    padding: 12px 14px;
    resize: vertical;
  }

  textarea {
    min-height: 110px;
  }

  .submit-row {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .submit-row .btn {
    border: none;
  }

  .form-status {
    font-size: 13.5px;
    color: var(--navy);
  }

  .form-status[data-state='err'] {
    color: #b0432c;
  }
</style>

<script>
  import { submitLead } from '../lib/leadForm';
  import { trackEvent } from '../lib/analytics';

  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.form-status');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute('disabled', 'true');

      const name = form.querySelector<HTMLInputElement>('#cname')?.value ?? '';
      const email = form.querySelector<HTMLInputElement>('#cemail')?.value ?? '';
      const message = form.querySelector<HTMLTextAreaElement>('#cmsg')?.value ?? '';

      try {
        await submitLead({ name, email, message }, 'General Contact');
        trackEvent('general_contact_submitted');
        if (status) {
          status.textContent = form.dataset.success ?? '';
          status.dataset.state = 'ok';
        }
        form.reset();
      } catch {
        if (status) {
          status.textContent = form.dataset.error ?? '';
          status.dataset.state = 'err';
        }
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  });
</script>

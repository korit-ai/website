---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, type Locale } from '../i18n/content';
import { GOATCOUNTER_ENDPOINT } from '../lib/analytics';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  nav: {
    product: string;
    focus: string;
    about: string;
    contact: string;
    portal: string;
    cta: string;
  };
  footerTagline: string;
}

const { locale, title, description, nav, footerTagline } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

function alternateURL(target: Locale) {
  const segments = Astro.url.pathname.split('/').filter(Boolean);
  segments[0] = target;
  return new URL(`/${segments.join('/')}/`, Astro.site);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {locales.map((loc) => <link rel="alternate" hreflang={loc} href={alternateURL(loc)} />)}
    <link rel="alternate" hreflang="x-default" href={alternateURL('tr')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Cookieless analytics, no consent banner needed — see kb/project/specs/lead-capture-demo-analytics.md -->
    <script is:inline data-goatcounter={GOATCOUNTER_ENDPOINT} async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a href="#top" class="skip-link">Skip to content</a>
    <Header locale={locale} nav={nav} />
    <main id="top">
      <slot />
    </main>
    <Footer tagline={footerTagline} />
    <script>
      const items = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
